<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="<%= it.baseurl %>/assets/tailwind.css" rel="stylesheet" />
  <script type="module" src="<%= it.baseurl %>/assets/kortxyz-components.esm.js"></script>
  <title>Tiles | <%= it.collection?.name || it.collectionId %></title>
  <style>
    @media (prefers-color-scheme: dark) {
      :root {
        --c-bg: #171717; --c-bg-header: #171717; --c-bg-card: #262626; --c-bg-input: #262626;
        --c-bg-active: #404040; --c-bg-inactive: #262626; --c-bg-btn: #f5f5f5; --c-bg-btn-hover: #fff;
        --c-bg-overlay: #262626; --c-bg-field: #171717;
        --c-border: #404040; --c-border-card: #404040; --c-border-badge: #525252;
        --c-text: #d4d4d4; --c-text-heading: #f5f5f5; --c-text-muted: #737373; --c-text-secondary: #a3a3a3;
        --c-text-btn: #171717; --c-text-badge: #a3a3a3; --c-text-active: #e5e5e5; --c-text-inactive: #a3a3a3;
        --c-ring: #525252;
      }
    }
    @media (prefers-color-scheme: light) {
      :root {
        --c-bg: #ffffff; --c-bg-header: #ffffff; --c-bg-card: #ffffff; --c-bg-input: #f5f5f5;
        --c-bg-active: #e5e5e5; --c-bg-inactive: #f5f5f5; --c-bg-btn: #171717; --c-bg-btn-hover: #262626;
        --c-bg-overlay: #ffffff; --c-bg-field: #f5f5f5;
        --c-border: #e5e5e5; --c-border-card: #e5e5e5; --c-border-badge: #d4d4d4;
        --c-text: #404040; --c-text-heading: #171717; --c-text-muted: #737373; --c-text-secondary: #525252;
        --c-text-btn: #ffffff; --c-text-badge: #525252; --c-text-active: #171717; --c-text-inactive: #737373;
        --c-ring: #a3a3a3;
      }
    }
    body { background: var(--c-bg); color: var(--c-text); }
    .t-heading { color: var(--c-text-heading); }
    .t-muted { color: var(--c-text-muted); }
    .t-secondary { color: var(--c-text-secondary); }
    .t-card { background: var(--c-bg-card); border-color: var(--c-border-card); }
    .t-card:hover { border-color: var(--c-text-muted); }
    .t-field {
      background: var(--c-bg-field);
      border-color: var(--c-border);
      color: var(--c-text-heading);
    }
    .t-field:focus {
      outline: none;
      box-shadow: 0 0 0 2px var(--c-ring);
    }
  </style>
</head>

<% const tileMatrixSet = "WebMercatorQuad"; %>
<% const tileUrl = `${it.baseurl}/collections/${it.collectionId}/tiles/${tileMatrixSet}/{z}/{x}/{y}`; %>
<% const metadataUrl = `${it.baseurl}/collections/${it.collectionId}/tiles/${tileMatrixSet}?f=json`; %>
<body class="min-h-screen" data-tile-url="<%= tileUrl %>">

  <main class="max-w-7xl mx-auto px-4 pt-2">
    <header class="mx-1 flex text-xs items-center justify-between mb-6">
      <div id="breadcrumbs" class="flex cursor-pointer opacity-20 hover:opacity-100 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 py-0.5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
        </svg>
        <% if (it.dataset) { %>
          <a class="hover:t-heading" href="<%= it.datasetsUrl %>">Home</a>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 pt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <a class="hover:t-heading" href="<%= it.baseurl %>"><%= it.dataset %></a>
        <% } else { %>
          <a class="hover:t-heading" href="<%= it.baseurl %>">Home</a>
        <% } %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 pt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <a class="hover:t-heading" href="<%= it.baseurl %>/collections">collections</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 pt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <a class="hover:t-heading" href="<%= it.baseurl %>/collections/<%= it.collectionId %>"><%= it.collection?.name || it.collectionId %></a>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 pt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <a class="hover:t-heading" href="<%= it.baseurl %>/collections/<%= it.collectionId %>/tiles">tiles</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 pt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <a class="cursor-default">WebMercatorQuad</a>
      </div>
      <a class="hover:text-neutral-300 px-1 opacity-20 hover:opacity-100 transition" href="?f=json" target="_blank">JSON</a>
    </header>

    <div class="mb-6">
      <h1 class="text-3xl font-bold t-heading mb-1">Tiles</h1>
      <p class="t-muted">Tile access and preview for <%= it.collection?.name || it.collectionId %>.</p>
    </div>


    <h2 class="text-xl font-semibold t-heading mb-4">Tileset Information</h2>
    <div class="space-y-1 mb-8">
      <div class="flex items-center py-2">
        <div class="flex items-center gap-2 w-48 shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 t-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/>
          </svg>
          <span class="text-sm font-medium t-heading">Tile Matrix Set</span>
        </div>
        <div class="flex-1 max-w-sm">
          <div name="TileMatrixSet" id="TileMatrixSet" class="t-field w-full rounded-lg border px-3 py-2 text-sm" disabled>
            WebMercatorQuad
          </div>
        </div>
      </div>
      <div class="flex items-start py-2">
        <div class="flex items-center gap-2 w-48 shrink-0 pt-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 t-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
          </svg>
          <span class="text-sm font-medium t-heading">URL Template</span>
        </div>
        <div id="tileUrlButton" onclick="copyTileUrl()" class="flex-1 text-left rounded-lg border px-4 py-3 text-sm t-secondary transition-colors hover:t-heading" style="border-color: var(--c-border)">
          <span class="block break-all"><%= tileUrl %></span>
        </div>
      </div>
      <div class="flex flex-col py-2">
        <div class="flex items-center gap-2 mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 t-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/>
          </svg>
          <span class="text-sm font-medium t-heading">Preview</span>
        </div>
        <div class="w-full h-96 rounded-lg overflow-hidden" id="map">
          <kortxyz-maplibre class="flex h-full w-full" show-tile-boundaries hoverpopup mapstyle="<%= it.baseurl %>/collections/<%= it.collectionId %>/styles/default?f=mbs"></kortxyz-maplibre>
        </div>
      </div>
    </div>
  </main>

  <script>
    async function copyTileUrl() {
      const tileUrl = document.body.dataset.tileUrl;
      const copyStatus = document.getElementById("copyStatus");

      try {
        await navigator.clipboard.writeText(tileUrl);
        if (copyStatus) copyStatus.textContent = "Copied to clipboard";
      } catch {
        if (copyStatus) copyStatus.textContent = "Copy failed";
      }
    }
  </script>
</body>

</html>