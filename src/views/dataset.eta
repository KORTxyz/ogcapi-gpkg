<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="<%= it.baseurl %>/assets/tailwind.css" rel="stylesheet" />
  <title>Datasets - KORTxyz</title>
  <style>
    [data-theme="dark"] {
      --c-bg: #171717; --c-bg-header: #171717; --c-bg-card: #262626; --c-bg-input: #262626;
      --c-bg-active: #404040; --c-bg-inactive: #262626; --c-bg-btn: #f5f5f5; --c-bg-btn-hover: #fff;
      --c-bg-overlay: #262626; --c-bg-field: #171717;
      --c-border: #404040; --c-border-card: #404040; --c-border-badge: #525252;
      --c-text: #d4d4d4; --c-text-heading: #f5f5f5; --c-text-muted: #737373; --c-text-secondary: #a3a3a3;
      --c-text-btn: #171717; --c-text-badge: #a3a3a3; --c-text-active: #e5e5e5; --c-text-inactive: #a3a3a3;
      --c-ring: #525252;
      --c-tag-bg: rgba(255,255,255,0.08); --c-tag-border: rgba(255,255,255,0.12); --c-tag-text: #a1a1aa;
      --c-tag-x: #71717a; --c-tag-x-hover: #fafafa;
      --c-cancel-border: #525252; --c-cancel-text: #d4d4d4; --c-cancel-hover: #404040;
      --c-file-text: #a3a3a3; --c-file-bg: #404040; --c-file-fg: #e5e5e5; --c-file-hover: #525252;
    }
    [data-theme="light"] {
      --c-bg: #ffffff; --c-bg-header: #ffffff; --c-bg-card: #ffffff; --c-bg-input: #f5f5f5;
      --c-bg-active: #e5e5e5; --c-bg-inactive: #f5f5f5; --c-bg-btn: #171717; --c-bg-btn-hover: #262626;
      --c-bg-overlay: #ffffff; --c-bg-field: #f5f5f5;
      --c-border: #e5e5e5; --c-border-card: #e5e5e5; --c-border-badge: #d4d4d4;
      --c-text: #404040; --c-text-heading: #171717; --c-text-muted: #737373; --c-text-secondary: #525252;
      --c-text-btn: #ffffff; --c-text-badge: #525252; --c-text-active: #171717; --c-text-inactive: #737373;
      --c-ring: #a3a3a3;
      --c-tag-bg: rgba(0,0,0,0.05); --c-tag-border: rgba(0,0,0,0.12); --c-tag-text: #525252;
      --c-tag-x: #737373; --c-tag-x-hover: #171717;
      --c-cancel-border: #d4d4d4; --c-cancel-text: #404040; --c-cancel-hover: #f5f5f5;
      --c-file-text: #525252; --c-file-bg: #e5e5e5; --c-file-fg: #171717; --c-file-hover: #d4d4d4;
    }
    body { background: var(--c-bg); color: var(--c-text); }
    .t-header { background: var(--c-bg-header); border-color: var(--c-border); }
    .t-heading { color: var(--c-text-heading); }
    .t-muted { color: var(--c-text-muted); }
    .t-secondary { color: var(--c-text-secondary); }
    .t-input { background: var(--c-bg-input); border-color: var(--c-border); color: var(--c-text-heading); }
    .t-input::placeholder { color: var(--c-text-muted); }
    .t-input:focus { outline: none; box-shadow: 0 0 0 2px var(--c-ring); }
    .t-card { background: var(--c-bg-card); border-color: var(--c-border-card); }
    .t-card:hover { border-color: var(--c-text-muted); }
    .t-badge { border-color: var(--c-border-badge); color: var(--c-text-badge); }
    .t-btn { background: var(--c-bg-btn); color: var(--c-text-btn); }
    .t-btn:hover { background: var(--c-bg-btn-hover); }
    .t-outline-btn { border-color: var(--c-border); color: var(--c-text); }
    .t-outline-btn:hover { background: var(--c-bg-input); }
    .t-toggle-active { background: var(--c-bg-active); color: var(--c-text-active); }
    .t-toggle-inactive { background: var(--c-bg-inactive); color: var(--c-text-inactive); }
    .t-toggle-inactive:hover, .t-toggle-active:hover { opacity: 0.85; }
    .t-overlay { background: var(--c-bg-overlay); border-color: var(--c-border); }
    .t-field { background: var(--c-bg-field); border-color: var(--c-border); color: var(--c-text-heading); }
    .t-field::placeholder { color: var(--c-text-muted); }
    .t-field:focus { outline: none; box-shadow: 0 0 0 2px var(--c-ring); }
    .t-label { color: var(--c-text-heading); }
    .tag-chip {
      display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.125rem 0.5rem;
      border-radius: 9999px; font-size: 0.75rem;
      background: var(--c-tag-bg); border: 1px solid var(--c-tag-border); color: var(--c-tag-text);
    }
    .tag-chip button {
      display: inline-flex; align-items: center; cursor: pointer;
      color: var(--c-tag-x); background: none; border: none; padding: 0; font-size: 0.875rem; line-height: 1;
    }
    .tag-chip button:hover { color: var(--c-tag-x-hover); }
    #dropOverlay {
      position: fixed; inset: 0; z-index: 100; display: none;
      background: rgba(0,0,0,0.55); backdrop-filter: blur(4px);
      align-items: center; justify-content: center;
      transition: opacity 0.15s ease;
    }
    #dropOverlay.active { display: flex; }
    #dropOverlay .drop-zone {
      border: 2px dashed var(--c-ring); border-radius: 1rem;
      padding: 3rem 4rem; text-align: center;
      background: var(--c-bg-overlay); max-width: 28rem;
    }
    #dropOverlay .drop-zone svg { margin: 0 auto 1rem; color: var(--c-text-muted); }
    #dropOverlay .drop-zone h3 { color: var(--c-text-heading); font-size: 1.25rem; font-weight: 600; margin-bottom: 0.25rem; }
    #dropOverlay .drop-zone p { color: var(--c-text-muted); font-size: 0.875rem; }
  </style>
</head>

<body class="min-h-screen">

  <!-- Navigation -->
  <header class="t-header border-b sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 py-3">
      <div class="flex items-center justify-between gap-4">
        <a href="<%= it.baseurl %>/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg t-btn">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <ellipse cx="12" cy="5" rx="9" ry="3"/>
              <path d="M3 5V19A9 3 0 0 0 21 19V5"/>
              <path d="M3 12A9 3 0 0 0 21 12"/>
            </svg>
          </div>
          <div>
            <div class="font-bold text-lg t-heading">KORTxyz</div>
            <div class="text-xs t-muted">Dataset Repository</div>
          </div>
        </a>
        <div class="flex items-center gap-2">
          <button id="themeToggle" class="p-2 rounded-lg t-outline-btn border transition-colors" title="Toggle theme">
            <svg id="iconMoon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
            <svg id="iconSun" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
          </button>
          <button id="uploadBtn" class="flex items-center gap-2 px-4 py-2 rounded-lg t-btn font-medium text-sm transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            <span class="hidden sm:inline">Upload Dataset</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-4 py-8">
    <!-- Breadcrumbs -->
    <header class="mx-1 flex text-xs items-center justify-between mb-6">
      <div id="breadcrumbs" class="flex cursor-pointer opacity-20 hover:opacity-100 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 py-0.5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
        </svg>
        <a class="cursor-default">datasets</a>
      </div>
      <a class="hover:text-neutral-300 px-1 opacity-20 hover:opacity-100 transition" href="?f=json" target="_blank">JSON</a>
    </header>

    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-3xl font-bold t-heading mb-1">Datasets</h1>
        <p class="t-muted">Browse available OGC API datasets</p>
      </div>
    </div>

    <!-- Search and View Controls -->
    <div class="flex flex-col sm:flex-row gap-3 mb-6">
      <div class="relative flex-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 t-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input id="searchInput" type="search" placeholder="Search datasets by name, keywords..." class="t-input w-full h-10 pl-10 pr-4 rounded-lg border text-sm">
      </div>
      <div class="flex gap-2">
        <select id="sortSelect" class="t-input h-10 px-3 rounded-lg border text-sm cursor-pointer">
          <option value="title-asc">Title (A-Z)</option>
          <option value="title-desc">Title (Z-A)</option>
        </select>
        <div class="flex rounded-lg overflow-hidden border" style="border-color: var(--c-border)">
          <button id="gridViewBtn" class="t-toggle-active flex items-center justify-center w-10 h-10 transition-colors" title="Grid view">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
            </svg>
          </button>
          <button id="listViewBtn" class="t-toggle-inactive flex items-center justify-center w-10 h-10 transition-colors" title="List view">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Dataset Count -->
    <p id="datasetCount" class="text-sm t-muted mb-6"></p>

    <!-- Datasets Grid -->
    <div id="datasetsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"></div>

    <!-- Datasets List -->
    <div id="datasetsList" class="space-y-4 hidden"></div>

    <!-- Empty State -->
    <div id="emptyState" class="text-center py-16 hidden">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 mx-auto mb-4" style="color: var(--c-border)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/>
      </svg>
      <h3 class="font-semibold text-lg mb-2" style="color: var(--c-text)">No datasets found</h3>
      <p class="t-muted">Try adjusting your search query</p>
    </div>
  </main>

  <!-- Upload Dialog Overlay -->
  <div id="uploadOverlay" class="fixed inset-0 z-50 hidden">
    <div class="fixed inset-0 bg-black/60" id="uploadBackdrop"></div>
    <div class="fixed inset-0 flex items-center justify-center p-4">
      <div class="t-overlay border rounded-xl shadow-2xl w-full max-w-lg relative">
        <div class="p-6">
          <div class="flex items-center justify-between mb-1">
            <h2 class="text-xl font-semibold t-heading">Upload Dataset</h2>
            <button id="uploadClose" class="p-1 rounded t-secondary transition-colors" style="hover: var(--c-text-heading)">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </div>
          <p class="text-sm t-secondary mb-6">Upload a new dataset to the OGC API server. Supported formats include GeoJSON, Shapefile, and GeoTIFF.</p>

          <form id="uploadForm" class="space-y-4">
            <div class="space-y-1.5">
              <label for="datasetName" class="block text-sm font-medium t-label">Dataset Name</label>
              <input id="datasetName" type="text" placeholder="Enter dataset name" required class="t-field w-full px-3 py-2 rounded-lg border text-sm">
            </div>

            <div class="space-y-1.5">
              <label for="datasetDesc" class="block text-sm font-medium t-label">Description</label>
              <textarea id="datasetDesc" rows="3" placeholder="Brief description of the dataset" class="t-field w-full px-3 py-2 rounded-lg border text-sm resize-none"></textarea>
            </div>

            <div class="space-y-1.5">
              <label for="tagsInput" class="block text-sm font-medium t-label">Tags</label>
              <div id="tagsContainer" class="flex flex-wrap gap-1.5 p-2 rounded-lg border min-h-[2.5rem] cursor-text" style="background: var(--c-bg-field); border-color: var(--c-border)">
                <input id="tagsInput" type="text" placeholder="Type a tag and press Enter" class="flex-1 min-w-[120px] bg-transparent border-none text-sm focus:outline-none" style="color: var(--c-text-heading)">
              </div>
              <p class="text-xs t-muted">Press Enter or comma to add a tag</p>
            </div>

            <div class="space-y-1.5">
              <label for="datasetFile" class="block text-sm font-medium t-label">Dataset File</label>
              <input id="datasetFile" type="file" accept=".gpkg" required class="w-full text-sm cursor-pointer" style="color: var(--c-file-text)">
            </div>

            <div class="space-y-1.5">
              <label for="datasetImage" class="block text-sm font-medium t-label">Dataset Image <span class="font-normal t-muted">(optional)</span></label>
              <input id="datasetImage" type="file" accept="image/*" class="w-full text-sm cursor-pointer" style="color: var(--c-file-text)">
              <div id="imagePreview" class="hidden mt-2">
                <img id="imagePreviewImg" class="rounded-lg border max-h-32 object-cover" style="border-color: var(--c-border)" alt="Preview">
              </div>
            </div>

            <!-- Progress bar -->
            <div id="uploadProgress" class="hidden space-y-1.5">
              <div class="flex items-center justify-between text-sm">
                <span class="t-label">Uploading…</span>
                <span id="uploadPercent" class="t-secondary">0%</span>
              </div>
              <div class="w-full h-2 rounded-full overflow-hidden" style="background: var(--c-bg-field)">
                <div id="uploadBar" class="h-full rounded-full transition-all" style="width: 0%; background: var(--c-bg-btn)"></div>
              </div>
            </div>

            <div class="flex justify-end gap-3 pt-2">
              <button type="button" id="uploadCancel" class="px-4 py-2 rounded-lg border text-sm transition-colors" style="border-color: var(--c-cancel-border); color: var(--c-cancel-text)">Cancel</button>
              <button type="submit" class="flex items-center gap-2 px-4 py-2 rounded-lg t-btn font-medium text-sm transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
                </svg>
                Upload Dataset
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Drag & Drop Overlay -->
  <div id="dropOverlay">
    <div class="drop-zone">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
      </svg>
      <h3>Drop dataset here</h3>
      <p>Only support OGC Geopackage</p>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/tus-js-client@4/dist/tus.min.js"></script>
  <script>
    const baseurl = "<%= it.baseurl %>";
    const datasets = <%~ JSON.stringify(it.datasetList) %>;

    // --- State ---
    let searchQuery = "";
    let sortBy = "title-asc";
    let viewMode = "grid";
    const uploadTags = [];

    // --- Elements ---
    const searchInput = document.getElementById("searchInput");
    const sortSelect = document.getElementById("sortSelect");
    const gridViewBtn = document.getElementById("gridViewBtn");
    const listViewBtn = document.getElementById("listViewBtn");
    const datasetsGrid = document.getElementById("datasetsGrid");
    const datasetsList = document.getElementById("datasetsList");
    const datasetCount = document.getElementById("datasetCount");
    const emptyState = document.getElementById("emptyState");

    // --- Filtering & Sorting ---
    function getFilteredDatasets() {
      const q = searchQuery.toLowerCase();
      let filtered = datasets.filter(d => {
        const tags = (d.tags || []).join(" ").toLowerCase();
        return d.title.toLowerCase().includes(q) ||
               (d.description || "").toLowerCase().includes(q) ||
               tags.includes(q);
      });

      filtered.sort((a, b) => {
        if (sortBy === "title-asc") return a.title.localeCompare(b.title);
        if (sortBy === "title-desc") return b.title.localeCompare(a.title);
        return 0;
      });
      return filtered;
    }

    // --- Render ---
    function renderDatasets() {
      const filtered = getFilteredDatasets();

      datasetCount.textContent = filtered.length + " " + (filtered.length === 1 ? "dataset" : "datasets") + " found";

      if (filtered.length === 0) {
        datasetsGrid.classList.add("hidden");
        datasetsList.classList.add("hidden");
        emptyState.classList.remove("hidden");
        return;
      }
      emptyState.classList.add("hidden");

      if (viewMode === "grid") {
        datasetsGrid.classList.remove("hidden");
        datasetsList.classList.add("hidden");
        datasetsGrid.innerHTML = filtered.map(renderGridCard).join("");
      } else {
        datasetsGrid.classList.add("hidden");
        datasetsList.classList.remove("hidden");
        datasetsList.innerHTML = filtered.map(renderListCard).join("");
      }
    }

    function escapeHtml(str) {
      const div = document.createElement("div");
      div.textContent = str || "";
      return div.innerHTML;
    }

    function renderGridCard(d) {
      const tags = (d.tags || []).slice(0, 3);
      const tagsHtml = tags.map(t =>
        '<span class="t-badge px-2 py-0.5 rounded-full text-xs border">' + escapeHtml(t) + '</span>'
      ).join("");

      return '<a href="' + escapeHtml(baseurl) + '/' + escapeHtml(d.id) + '" class="block group">' +
        '<div class="t-card rounded-xl overflow-hidden border transition-colors h-full flex flex-col">' +
          '<div class="aspect-video overflow-hidden" style="background: var(--c-border)">' +
            '<img src="' + escapeHtml(d.thumbnail) + '" alt="' + escapeHtml(d.title) + '" class="w-full h-full object-cover group-hover:scale-105 transition-transform" loading="lazy">' +
          '</div>' +
          '<div class="p-4 flex-1 flex flex-col">' +
            '<h3 class="font-semibold t-heading mb-1 truncate">' + escapeHtml(d.title) + '</h3>' +
            '<p class="text-sm t-secondary mb-3 line-clamp-2">' + escapeHtml(d.description) + '</p>' +
            '<div class="mt-auto flex flex-wrap gap-1.5">' + tagsHtml + '</div>' +
          '</div>' +
        '</div>' +
      '</a>';
    }

    function renderListCard(d) {
      const tags = (d.tags || []).slice(0, 4);
      const tagsHtml = tags.map(t =>
        '<span class="t-badge px-2 py-0.5 rounded-full text-xs border">' + escapeHtml(t) + '</span>'
      ).join("");

      return '<a href="' + escapeHtml(baseurl) + '/' + escapeHtml(d.id) + '" class="block">' +
        '<div class="t-card flex gap-4 p-4 rounded-xl border transition-colors">' +
          '<div class="w-32 h-24 rounded-lg overflow-hidden shrink-0" style="background: var(--c-border)">' +
            '<img src="' + escapeHtml(d.thumbnail) + '" alt="' + escapeHtml(d.title) + '" class="w-full h-full object-cover" loading="lazy">' +
          '</div>' +
          '<div class="flex-1 min-w-0">' +
            '<h3 class="font-semibold t-heading mb-1">' + escapeHtml(d.title) + '</h3>' +
            '<p class="text-sm t-secondary mb-2 line-clamp-2">' + escapeHtml(d.description) + '</p>' +
            '<div class="flex flex-wrap gap-1.5">' + tagsHtml + '</div>' +
          '</div>' +
        '</div>' +
      '</a>';
    }

    // --- Event Listeners ---
    searchInput.addEventListener("input", function() {
      searchQuery = this.value;
      renderDatasets();
    });

    sortSelect.addEventListener("change", function() {
      sortBy = this.value;
      renderDatasets();
    });

    function setViewMode(mode) {
      viewMode = mode;
      if (mode === "grid") {
        gridViewBtn.className = "t-toggle-active flex items-center justify-center w-10 h-10 transition-colors";
        listViewBtn.className = "t-toggle-inactive flex items-center justify-center w-10 h-10 transition-colors";
      } else {
        listViewBtn.className = "t-toggle-active flex items-center justify-center w-10 h-10 transition-colors";
        gridViewBtn.className = "t-toggle-inactive flex items-center justify-center w-10 h-10 transition-colors";
      }
      renderDatasets();
    }

    gridViewBtn.addEventListener("click", () => setViewMode("grid"));
    listViewBtn.addEventListener("click", () => setViewMode("list"));

    // --- Theme Toggle ---
    const themeToggle = document.getElementById("themeToggle");
    const iconMoon = document.getElementById("iconMoon");
    const iconSun = document.getElementById("iconSun");

    function applyTheme(theme) {
      document.documentElement.setAttribute("data-theme", theme);
      if (theme === "light") {
        iconMoon.classList.add("hidden");
        iconSun.classList.remove("hidden");
      } else {
        iconSun.classList.add("hidden");
        iconMoon.classList.remove("hidden");
      }
    }

    themeToggle.addEventListener("click", function() {
      const current = localStorage.getItem("theme") || "dark";
      const next = current === "dark" ? "light" : "dark";
      localStorage.setItem("theme", next);
      applyTheme(next);
    });

    applyTheme(localStorage.getItem("theme") || "dark");

    // --- Upload Dialog ---
    const uploadOverlay = document.getElementById("uploadOverlay");
    const uploadBtn = document.getElementById("uploadBtn");
    const uploadClose = document.getElementById("uploadClose");
    const uploadCancel = document.getElementById("uploadCancel");
    const uploadBackdrop = document.getElementById("uploadBackdrop");
    const uploadForm = document.getElementById("uploadForm");

    function openUpload() { uploadOverlay.classList.remove("hidden"); }
    function closeUpload() {
      if (activeUpload) { activeUpload.abort(); activeUpload = null; }
      document.getElementById("uploadProgress").classList.add("hidden");
      uploadOverlay.classList.add("hidden");
    }

    uploadBtn.addEventListener("click", openUpload);
    uploadClose.addEventListener("click", closeUpload);
    uploadCancel.addEventListener("click", closeUpload);
    uploadBackdrop.addEventListener("click", closeUpload);

    // --- Tags Input ---
    const tagsInput = document.getElementById("tagsInput");
    const tagsContainer = document.getElementById("tagsContainer");

    tagsContainer.addEventListener("click", () => tagsInput.focus());

    function addTag(text) {
      const tag = text.trim().toLowerCase();
      if (!tag || uploadTags.includes(tag)) return;
      uploadTags.push(tag);
      renderUploadTags();
    }

    function removeTag(tag) {
      const idx = uploadTags.indexOf(tag);
      if (idx !== -1) uploadTags.splice(idx, 1);
      renderUploadTags();
    }

    function renderUploadTags() {
      const chips = tagsContainer.querySelectorAll(".tag-chip");
      chips.forEach(c => c.remove());

      uploadTags.forEach(tag => {
        const chip = document.createElement("span");
        chip.className = "tag-chip";
        chip.innerHTML = escapeHtml(tag) + '<button type="button" aria-label="Remove tag">&times;</button>';
        chip.querySelector("button").addEventListener("click", () => removeTag(tag));
        tagsContainer.insertBefore(chip, tagsInput);
      });
    }

    tagsInput.addEventListener("keydown", function(e) {
      if (e.key === "Enter" || e.key === ",") {
        e.preventDefault();
        addTag(this.value);
        this.value = "";
      }
      if (e.key === "Backspace" && !this.value && uploadTags.length) {
        removeTag(uploadTags[uploadTags.length - 1]);
      }
    });

    tagsInput.addEventListener("blur", function() {
      if (this.value.trim()) {
        addTag(this.value);
        this.value = "";
      }
    });

    let activeUpload = null;

    // --- Image Preview ---
    const datasetImageInput = document.getElementById("datasetImage");
    const imagePreview = document.getElementById("imagePreview");
    const imagePreviewImg = document.getElementById("imagePreviewImg");

    datasetImageInput.addEventListener("change", function() {
      const file = this.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          imagePreviewImg.src = e.target.result;
          imagePreview.classList.remove("hidden");
        };
        reader.readAsDataURL(file);
      } else {
        imagePreview.classList.add("hidden");
        imagePreviewImg.src = "";
      }
    });

    function uploadThumbnail(datasetName, onDone) {
      const imageFile = datasetImageInput.files[0];
      if (!imageFile) return onDone();

      const thumbUpload = new tus.Upload(imageFile, {
        endpoint: baseurl + "/upload",
        retryDelays: [0, 1000, 3000],
        metadata: {
          filename: imageFile.name,
          filetype: imageFile.type || "image/png",
          uploadType: "thumbnail",
          dataset: datasetName,
        },
        onSuccess: function() { onDone(); },
        onError: function(err) {
          console.warn("Thumbnail upload failed:", err);
          onDone();
        },
      });
      thumbUpload.start();
    }

    uploadForm.addEventListener("submit", function(e) {
      e.preventDefault();
      const file = document.getElementById("datasetFile").files[0];
      if (!file) return;

      const progressEl = document.getElementById("uploadProgress");
      const percentEl = document.getElementById("uploadPercent");
      const barEl = document.getElementById("uploadBar");
      progressEl.classList.remove("hidden");
      barEl.style.width = "0%";
      percentEl.textContent = "0%";

      activeUpload = new tus.Upload(file, {
        endpoint: baseurl + "/upload",
        retryDelays: [0, 1000, 3000, 5000],
        metadata: {
          filename: file.name,
          filetype: file.type || "application/octet-stream",
          name: document.getElementById("datasetName").value,
          description: document.getElementById("datasetDesc").value,
          tags: JSON.stringify(uploadTags),
        },
        onProgress: function(bytesUploaded, bytesTotal) {
          const pct = Math.round((bytesUploaded / bytesTotal) * 100);
          barEl.style.width = pct + "%";
          percentEl.textContent = pct + "%";
        },
        onSuccess: function() {
          activeUpload = null;
          const dsName = file.name.replace(/\.gpkg$/i, "");
          uploadThumbnail(dsName, function() {
            progressEl.classList.add("hidden");
            closeUpload();
            location.reload();
          });
        },
        onError: function(err) {
          activeUpload = null;
          progressEl.classList.add("hidden");
          console.error("Upload failed:", err);
        },
      });

      activeUpload.findPreviousUploads().then(function(previousUploads) {
        if (previousUploads.length) activeUpload.resumeFromPreviousUpload(previousUploads[0]);
        activeUpload.start();
      });
    });

    // --- Drag & Drop Overlay ---
    const dropOverlay = document.getElementById("dropOverlay");
    let dragCounter = 0;

    document.addEventListener("dragenter", function(e) {
      e.preventDefault();
      if (!e.dataTransfer.types.includes("Files")) return;
      dragCounter++;
      if (dragCounter === 1) dropOverlay.classList.add("active");
    });

    document.addEventListener("dragleave", function(e) {
      e.preventDefault();
      if (!e.dataTransfer.types.includes("Files")) return;
      dragCounter--;
      if (dragCounter === 0) dropOverlay.classList.remove("active");
    });

    document.addEventListener("dragover", function(e) {
      if (!e.dataTransfer.types.includes("Files")) return;
      e.preventDefault();
    });

    dropOverlay.addEventListener("drop", function(e) {
      e.preventDefault();
      dragCounter = 0;
      dropOverlay.classList.remove("active");

      const file = e.dataTransfer.files[0];
      if (!file) return;

      const fileInput = document.getElementById("datasetFile");
      const dt = new DataTransfer();
      dt.items.add(file);
      fileInput.files = dt.files;

      const nameInput = document.getElementById("datasetName");
      if (!nameInput.value) {
        nameInput.value = file.name.replace(/\.[^.]+$/, "");
      }

      openUpload();
    });

    // --- Init ---
    renderDatasets();
  </script>

</body>
</html>
