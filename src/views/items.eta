<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="<%= it.baseurl %>/assets/tailwind.css" rel="stylesheet" />
  <script type="module" src="<%= it.baseurl %>/assets/kortxyz-components.esm.js"></script>
  <title>Items — <%= it.collectionId %></title>
  <style>
    @media (prefers-color-scheme: dark) {
      :root {
        --c-bg: #171717; --c-bg-card: #262626; --c-bg-input: #262626;
        --c-bg-active: #404040; --c-bg-inactive: #262626;
        --c-border: #404040; --c-border-card: #404040;
        --c-text: #d4d4d4; --c-text-heading: #f5f5f5; --c-text-muted: #737373; --c-text-secondary: #a3a3a3;
        --c-ring: #525252;
        --c-resizer: #404040; --c-resizer-hover: #525252;
      }
    }
    @media (prefers-color-scheme: light) {
      :root {
        --c-bg: #ffffff; --c-bg-card: #ffffff; --c-bg-input: #f5f5f5;
        --c-bg-active: #e5e5e5; --c-bg-inactive: #f5f5f5;
        --c-border: #e5e5e5; --c-border-card: #e5e5e5;
        --c-text: #404040; --c-text-heading: #171717; --c-text-muted: #737373; --c-text-secondary: #525252;
        --c-ring: #a3a3a3;
        --c-resizer: #e5e5e5; --c-resizer-hover: #d4d4d4;
      }
    }
    body { background: var(--c-bg); color: var(--c-text); }
    .t-heading { color: var(--c-text-heading); }
    .t-muted { color: var(--c-text-muted); }
    .t-secondary { color: var(--c-text-secondary); }
    .t-card { background: var(--c-bg-card); border-color: var(--c-border-card); }
    .t-toggle-active { background: var(--c-bg-active); color: var(--c-text-heading); }
    .t-toggle-inactive { background: var(--c-bg-inactive); color: var(--c-text-muted); }
    .t-toggle-inactive:hover, .t-toggle-active:hover { opacity: 0.85; }
    #resizer { background: var(--c-resizer); }
    #resizer:hover { background: var(--c-resizer-hover); }
  </style>
</head>

<body class="flex flex-col h-screen max-h-full">

  <!-- Header bar -->
  <div class="shrink-0 px-4 pt-2 pb-3">
    <!-- Breadcrumbs -->
    <header class="mx-1 flex text-xs items-center justify-between mb-4">
      <div id="breadcrumbs" class="flex cursor-pointer opacity-20 hover:opacity-100 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 py-0.5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
        </svg>
        <% if (it.dataset) { %>
          <a class="hover:t-heading" href="<%= it.datasetsUrl %>">Home</a>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 pt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <a class="hover:t-heading" href="<%= it.baseurl %>"><%= it.dataset %></a>
        <% } else { %>
          <a class="hover:t-heading" href="<%= it.baseurl %>">home</a>
        <% } %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 pt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <a class="hover:t-heading" href="<%= it.baseurl %>/collections">collections</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 pt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <a class="hover:t-heading" href="<%= it.baseurl %>/collections/<%= it.collectionId %>"><%= it.collectionId %></a>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 pt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <a class="cursor-default">items</a>
      </div>
      <a class="hover:t-heading px-1 opacity-20 hover:opacity-100 transition" href="?f=json" target="_blank">JSON</a>
    </header>

    <!-- Title row -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold t-heading"><%= it.collectionId %></h1>
        <p class="text-sm t-muted">Feature items</p>
      </div>
      <div class="flex items-center gap-2">
        <button id="mapViewBtn" class="t-toggle-active flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors" title="Toggle map">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/>
          </svg>
          Map
        </button>
        <button id="tableViewBtn" class="t-toggle-active flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors" title="Toggle table">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/>
          </svg>
          Table
        </button>
      </div>
    </div>
  </div>

  <!-- Data store -->
  <kortxyz-datastore
    store="items"
    data="<%= it.baseurl %>/collections/<%= it.collectionId %>/items?<%= it.extraParams %><%= it.properties ? '&properties=' + it.properties : '' %>"
    <%= it.readonly ? "" : "sync" %>
  ></kortxyz-datastore>

  <!-- Map panel -->
  <kortxyz-maplibre
    id="mapPanel"
    class="basis-1/2 shrink-0 grow-0 overflow-hidden"
    style="border: 1px solid var(--c-border-card);"
    <%= it.readonly ? "" : "draw=items" %>
    basemaps="<%= it.baseurl %>/styles"
  >
    <kortxyz-maplibre-source sourceid="items" store="items" fit></kortxyz-maplibre-source>
  </kortxyz-maplibre>

  <!-- Resizer -->

  <!-- Table panel -->
  <kortxyz-aggrid
    id="tablePanel"
    class="grow shrink overflow-hidden"
    style="border: 1px solid var(--c-border-card);"
    store="items"
    schema="<%= it.baseurl %>/collections/<%= it.collectionId %>/schema"
    <%= it.readonly ? "" : "editable" %>
  ></kortxyz-aggrid>

  <script>
    /* Resizer logic */
    const mapPanel = document.getElementById('mapPanel');


    /* Toggle panels */
    const mapBtn = document.getElementById('mapViewBtn');
    const tableBtn = document.getElementById('tableViewBtn');
    const tablePanel = document.getElementById('tablePanel');
    const resizer = document.getElementById('resizer');

    let mapVisible = true, tableVisible = true;

    function updateToggle(btn, active) {
      btn.classList.toggle('t-toggle-active', active);
      btn.classList.toggle('t-toggle-inactive', !active);
    }

    mapBtn.addEventListener('click', () => {
      mapVisible = !mapVisible;
      if (!mapVisible && !tableVisible) tableVisible = true;
      applyLayout();
    });

    tableBtn.addEventListener('click', () => {
      tableVisible = !tableVisible;
      if (!tableVisible && !mapVisible) mapVisible = true;
      applyLayout();
    });

    function applyLayout() {
      updateToggle(mapBtn, mapVisible);
      updateToggle(tableBtn, tableVisible);
      mapPanel.style.display = mapVisible ? '' : 'none';
      tablePanel.style.display = tableVisible ? '' : 'none';
      resizer.style.display = (mapVisible && tableVisible) ? '' : 'none';
      if (mapVisible && !tableVisible) {
        mapPanel.style.flexBasis = '';
        mapPanel.style.flexGrow = '1';
      } else {
        mapPanel.style.flexGrow = '0';
        mapPanel.style.flexBasis = '50%';
      }
      if (typeof map !== 'undefined') setTimeout(() => map.resize(), 0);
    }
  </script>
</body>

</html>